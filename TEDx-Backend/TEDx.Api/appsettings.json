{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "Logs/log-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ADMIN_EMAIL": "admin@tedx.com",
  "ADMIN_PASSWORD": "",
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromName": "TEDxAlkawmia",
    "FromAddress": "noreply@tedx.com"
  },
  "Jwt": {
    "Issuer": "TEDxAlkawmia",
    "Audience": "TEDxAlkawmia.Client",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "MaxFileSizeBytes": 5242880,
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "UploadFolder": "tedx"
  },
  "Paymob": {
    "BaseUrl": "https://accept.paymob.com/api/",
    "ApiKey": "",
    "HmacSecret": "",
    "IntegrationIds": []
  },
  "Frontend": {
    "BaseUrl": "",
    "ResetPasswordPath": "/reset-password",
    "ConfirmEmailPath": "/confirm-email"
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ]
  },
  "IdentityPolicy": {
    "PasswordMinLength": 8,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "ResetTokenHours": 1,
    "ConfirmTokenHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "TrustForwardedHeaders": false,
    "TrustedProxies": [],
    "Groups": {
      "auth": {
        "PermitLimit": 10,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "auth-mail": {
        "PermitLimit": 3,
        "WindowSeconds": 300,
        "QueueLimit": 0
      }
    }
  },
  "Sweeper": {
    "IntervalSeconds": 30,
    "LockTimeoutMs": 5000,
    "RefreshTokenRetentionDays": 30
  }
}